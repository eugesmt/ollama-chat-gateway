# HTTP server
LISTEN_ADDR=:8080
APP_PORT=8080

# Compose default: host Ollama through Docker's host gateway.
# Use http://127.0.0.1:11434 for a native Go process.
# For the compose Ollama profile, use http://ollama:11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Queue and generation limits
WORKER_COUNT=1
QUEUE_SIZE=8
MAX_INPUT_CHARS=8000
MAX_MESSAGES=20
MAX_OUTPUT_TOKENS=512
NUM_CTX=4096

# Per-IP request limit and in-memory job lifetime
RATE_LIMIT_RPM=5
JOB_TTL=15m
REQUEST_TIMEOUT=2m

# Replace before exposing the service beyond a trusted local machine.
API_KEY=replace-with-a-long-random-value
